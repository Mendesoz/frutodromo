{
  "name": "brotalume-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/start.ts",
    "build": "tsc",
    "start": "node build/start.js",
    "check": "tsc --noEmit && node --check web/app.js && node --check web/map.js",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "verify": "npm run check && npm test",
    "review:claude": "node tools/claude-review.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
